local RunService   = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local LP   = Players.LocalPlayer
local PGui = LP:WaitForChild("PlayerGui")

local Cfg = {
    Enabled     = false,
    HitboxSize  = 40,       -- studs во все стороны
    Transparent = true,     -- скрыть расширенный хитбокс визуально
}

-- хранилище оригинальных размеров
local originals = {}  -- [player] = {hrp = Vector3, parts = {[part] = Vector3}}

-- ── EXPAND / RESTORE ─────────────────────────────────────────────────────────

local function ExpandPlayer(plr)
    if plr == LP then return end
    local char = plr.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if originals[plr] then return end  -- уже расширен

    local saved = { hrp = hrp.Size, parts = {} }

    -- расширяем HRP
    pcall(function()
        saved.hrp = hrp.Size
        hrp.Size  = Vector3.new(Cfg.HitboxSize, Cfg.HitboxSize, Cfg.HitboxSize)
        if Cfg.Transparent then
            hrp.LocalTransparencyModifier = 1
        end
    end)

    -- расширяем все остальные BasePart для максимального покрытия
    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") and part ~= hrp then
            pcall(function()
                saved.parts[part] = part.Size
                local s = Cfg.HitboxSize * 0.6
                part.Size = Vector3.new(s, s, s)
                if Cfg.Transparent then
                    part.LocalTransparencyModifier = 1
                end
            end)
        end
    end

    originals[plr] = saved
end

local function RestorePlayer(plr)
    local char = plr.Character
    local saved = originals[plr]
    if not saved then return end

    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            pcall(function()
                hrp.Size = saved.hrp
                hrp.LocalTransparencyModifier = 0
            end)
        end
        for part, sz in pairs(saved.parts) do
            pcall(function()
                part.Size = sz
                part.LocalTransparencyModifier = 0
            end)
        end
    end

    originals[plr] = nil
end

local function ExpandAll()
    for _, plr in ipairs(Players:GetPlayers()) do
        pcall(ExpandPlayer, plr)
    end
end

local function RestoreAll()
    for plr, _ in pairs(originals) do
        pcall(RestorePlayer, plr)
    end
    originals = {}
end

-- при новом персонаже игрока — расширяем снова если включено
Players.PlayerAdded:Connect(function(plr)
    plr.CharacterAdded:Connect(function()
        task.wait(0.5)
        if Cfg.Enabled then
            pcall(ExpandPlayer, plr)
        end
    end)
end)

-- для уже существующих игроков подписываемся на respawn
for _, plr in ipairs(Players:GetPlayers()) do
    if plr ~= LP then
        plr.CharacterAdded:Connect(function()
            task.wait(0.5)
            if Cfg.Enabled then
                originals[plr] = nil  -- сброс чтобы ExpandPlayer не скипнул
                pcall(ExpandPlayer, plr)
            end
        end)
    end
end

Players.PlayerRemoving:Connect(function(plr)
    originals[plr] = nil
end)

