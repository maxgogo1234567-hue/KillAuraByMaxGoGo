-- ── TOGGLE ───────────────────────────────────────────────────────────────────

local function SetState(on)
    Cfg.Enabled = on
    if on then
        StatusLabel.Text       = "Status:  ON"
        StatusLabel.TextColor3 = Color3.fromRGB(80, 220, 100)
        ToggleBtn.Text         = "Disable"
        TweenService:Create(ToggleBtn, TweenInfo.new(0.15), {
            BackgroundColor3 = Color3.fromRGB(50, 180, 80)
        }):Play()
        BtnStroke.Color = Color3.fromRGB(50, 180, 80)
        ExpandAll()
    else
        StatusLabel.Text       = "Status:  OFF"
        StatusLabel.TextColor3 = Color3.fromRGB(200, 70, 70)
        ToggleBtn.Text         = "Enable"
        TweenService:Create(ToggleBtn, TweenInfo.new(0.15), {
            BackgroundColor3 = Color3.fromRGB(40, 40, 58)
        }):Play()
        BtnStroke.Color = Color3.fromRGB(100, 100, 140)
        RestoreAll()
    end
end

ToggleBtn.MouseButton1Click:Connect(function()
    SetState(not Cfg.Enabled)
end)

-- ── KEEPALIVE — переприменяем если хитбокс сбросился ────────────────────────

RunService.Heartbeat:Connect(function()
    if not Cfg.Enabled then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local char = plr.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp and hrp.Size.X < Cfg.HitboxSize - 1 then
                    -- хитбокс сбросился (respawn/reset) — расширяем снова
                    originals[plr] = nil
                    pcall(ExpandPlayer, plr)
                end
            end
        end
    end
end)

end)

