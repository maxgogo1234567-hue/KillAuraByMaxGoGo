-- ── ARG BUILDER ──────────────────────────────────────────────────────────────
-- строит таблицу аргументов для нового target
-- заменяет любой Instance из вражеского Character на соответствующий из target

local function MakeBuilder(originalArgs, sourceChar)
    return function(targetPlayer)
        local tChar = targetPlayer.Character
        if not tChar then return nil end
        local tHum = tChar:FindFirstChild("Humanoid")
        local tHRP = tChar:FindFirstChild("HumanoidRootPart")
        if not tHum or tHum.Health <= 0 or not tHRP then return nil end

        local built = {}
        for i, v in ipairs(originalArgs) do
            local t = typeof(v)
            if t == "Instance" then
                if v == sourceChar then
                    built[i] = tChar
                elseif v.Parent == sourceChar then
                    built[i] = tChar:FindFirstChild(v.Name) or tHRP
                else
                    built[i] = v
                end
            elseif t == "Vector3" then
                built[i] = tHRP.Position
            elseif t == "CFrame" then
                built[i] = tHRP.CFrame
            else
                built[i] = v
            end
        end
        return built
    end
end

-- ── HOOKMETAMETHOD — перехват FireServer ──────────────────────────────────────
-- срабатывает при каждом RemoteEvent:FireServer в игре
-- ищет в args Instance принадлежащую enemy Character → это damage remote

pcall(function()
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()

        if method == "FireServer" and self:IsA("RemoteEvent") then
            local args = {...}
            for _, v in ipairs(args) do
                if typeof(v) == "Instance" then
                    for _, plr in ipairs(Players:GetPlayers()) do
                        if plr ~= LP and plr.Character then
                            if v == plr.Character or v.Parent == plr.Character then
                                -- поймали damage remote
                                capturedRemote  = self
                                capturedBuilder = MakeBuilder(args, plr.Character)
                                hookActive      = true
                                break
                            end
                        end
                    end
                end
            end
        end

        return oldNamecall(self, ...)
    end)
end)

-- ── FALLBACK — поиск damage remote по имени ───────────────────────────────────
-- используется если hookmetamethod не поддерживается executor'ом

local function FindRemoteByKeyword()
    local kw = {
        "damage","hit","attack","strike","hurt","slash",
        "stab","sword","knife","melee","swing","smash"
    }
    local function scan(root)
        for _, obj in ipairs(root:GetDescendants()) do
            if obj:IsA("RemoteEvent") then
                local name = obj.Name:lower()
                for _, k in ipairs(kw) do
                    if name:find(k) then return obj end
                end
            end
        end
    end
    return scan(game:GetService("ReplicatedStorage"))
        or scan(workspace)
end

