-- ── TOGGLE LOGIC ─────────────────────────────────────────────────────────────

local function SetState(on)
    Cfg.Enabled = on
    if on then
        StatusLabel.Text       = "Status:  ON"
        StatusLabel.TextColor3 = Color3.fromRGB(80, 220, 100)
        ToggleBtn.Text         = "Disable"
        TweenService:Create(ToggleBtn, TweenInfo.new(0.15), {
            BackgroundColor3 = Color3.fromRGB(50, 180, 80)
        }):Play()
        BtnStroke.Color = Color3.fromRGB(50, 180, 80)
    else
        StatusLabel.Text       = "Status:  OFF"
        StatusLabel.TextColor3 = Color3.fromRGB(200, 70, 70)
        ToggleBtn.Text         = "Enable"
        TweenService:Create(ToggleBtn, TweenInfo.new(0.15), {
            BackgroundColor3 = Color3.fromRGB(40, 40, 58)
        }):Play()
        BtnStroke.Color = Color3.fromRGB(100, 100, 140)
    end
end

ToggleBtn.MouseButton1Click:Connect(function()
    SetState(not Cfg.Enabled)
end)

-- ── MELEE DETECTION ──────────────────────────────────────────────────────────

-- returns equipped tool if it looks like melee (no Shoot/Fire remotes)
local function GetMeleeTool()
    if not Char then return nil end
    for _, obj in ipairs(Char:GetChildren()) do
        if obj:IsA("Tool") then
            local isRanged = obj:FindFirstChild("ShootEvent")
                or obj:FindFirstChild("BulletEvent")
                or obj:FindFirstChild("FireRemote")
            if not isRanged then
                return obj
            end
        end
    end
    return nil
end

-- ── ATTACK ───────────────────────────────────────────────────────────────────

local function SwingAt(target)
    local tool = GetMeleeTool()
    if not tool then return end

    local tChar = target.Character
    if not tChar then return end

    local tHRP = tChar:FindFirstChild("HumanoidRootPart")
    local tHum = tChar:FindFirstChild("Humanoid")
    if not tHRP or not tHum or tHum.Health <= 0 then return end
    if not HRP then return end

    local dist = (HRP.Position - tHRP.Position).Magnitude
    if dist > Cfg.Range then return end

    -- nudge into melee contact, swing, return
    local origin = HRP.CFrame
    HRP.CFrame   = tHRP.CFrame * CFrame.new(0, 0, -2.5)

    pcall(function() tool:Activate() end)

    -- fire any game-specific melee remote
    pcall(function()
        local re = tool:FindFirstChildWhichIsA("RemoteEvent")
        if re then re:FireServer() end
        local rf = tool:FindFirstChildWhichIsA("RemoteFunction")
        if rf then rf:InvokeServer() end
    end)

    task.wait(0.05)
    HRP.CFrame = origin
end

-- ── MAIN LOOP ────────────────────────────────────────────────────────────────

task.spawn(function()
    while true do
        task.wait(Cfg.Delay)

        if Cfg.Enabled and Char then
            local myHum = Char:FindFirstChild("Humanoid")
            if HRP and myHum and myHum.Health > 0 then
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LP and Cfg.Enabled then
                        pcall(SwingAt, player)
                    end
                end
            end
        end
    end
end)
