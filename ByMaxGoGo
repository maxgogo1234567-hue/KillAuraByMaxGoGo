-- ── TOGGLE ───────────────────────────────────────────────────────────────────

local function SetState(on)
    Cfg.Enabled = on
    if on then
        StatusLabel.Text       = "Status:  ON"
        StatusLabel.TextColor3 = Color3.fromRGB(80, 220, 100)
        ToggleBtn.Text         = "Disable"
        TweenService:Create(ToggleBtn, TweenInfo.new(0.15), {
            BackgroundColor3 = Color3.fromRGB(50, 180, 80)
        }):Play()
        BtnStroke.Color = Color3.fromRGB(50, 180, 80)
    else
        StatusLabel.Text       = "Status:  OFF"
        StatusLabel.TextColor3 = Color3.fromRGB(200, 70, 70)
        ToggleBtn.Text         = "Enable"
        TweenService:Create(ToggleBtn, TweenInfo.new(0.15), {
            BackgroundColor3 = Color3.fromRGB(40, 40, 58)
        }):Play()
        BtnStroke.Color = Color3.fromRGB(100, 100, 140)
    end
end

ToggleBtn.MouseButton1Click:Connect(function()
    SetState(not Cfg.Enabled)
end)

-- ── TOOL ─────────────────────────────────────────────────────────────────────

local function GetMeleeTool()
    if not Char then return nil end
    for _, obj in ipairs(Char:GetChildren()) do
        if obj:IsA("Tool") then
            local ranged = obj:FindFirstChild("ShootEvent")
                or obj:FindFirstChild("BulletEvent")
                or obj:FindFirstChild("FireRemote")
            if not ranged then return obj end
        end
    end
    return nil
end

-- ── ATTACK — camera-locked ghost step ────────────────────────────────────────
--
-- 1. Фиксируем камеру (Scriptable) — игрок не видит телепорт
-- 2. HRP.CFrame → рядом с целью (сервер это видит и регистрирует proximity)
-- 3. tool:Activate() → hit detection игры срабатывает, урон реальный
-- 4. task.wait() — один physics step, сервер обработал
-- 5. HRP.CFrame → обратно на место
-- 6. Камера → Custom обратно
--

local busy = false

local function Attack(tool, target)
    if busy then return end
    local tChar = target.Character
    if not tChar then return end
    local tHum = tChar:FindFirstChild("Humanoid")
    local tHRP = tChar:FindFirstChild("HumanoidRootPart")
    if not tHum or tHum.Health <= 0 or not tHRP or not HRP then return end

    busy = true

    local savedPos    = HRP.CFrame
    local savedCamCF  = Camera.CFrame
    local savedCamType = Camera.CameraType

    -- заморозить камеру — игрок не увидит телепорт
    Camera.CameraType = Enum.CameraType.Scriptable
    Camera.CFrame     = savedCamCF

    -- переместить HRP к цели (сервер видит)
    HRP.CFrame = tHRP.CFrame * CFrame.new(0, 0, -2.2)

    -- активировать tool — игра регистрирует hit
    pcall(function() tool:Activate() end)

    -- remote fallback на случай remote-based damage
    for _, re in ipairs(tool:GetDescendants()) do
        if re:IsA("RemoteEvent") then
            pcall(function() re:FireServer(tChar) end)
            pcall(function() re:FireServer(tHum) end)
        end
        if re:IsA("RemoteFunction") then
            pcall(function() re:InvokeServer(tChar) end)
        end
    end

    -- один physics step
    task.wait()

    -- вернуть на место
    HRP.CFrame = savedPos

    -- восстановить камеру
    Camera.CameraType = savedCamType
    if savedCamType == Enum.CameraType.Scriptable then
        Camera.CFrame = savedCamCF
    end

    busy = false
end

-- ── MAIN LOOP ────────────────────────────────────────────────────────────────

task.spawn(function()
    while true do
        task.wait(Cfg.Delay)
        if Cfg.Enabled and Char then
            local myHum = Char:FindFirstChild("Humanoid")
            if myHum and myHum.Health > 0 then
                local tool = GetMeleeTool()
                if tool then
                    for _, plr in ipairs(Players:GetPlayers()) do
                        if plr ~= LP then
                            pcall(Attack, tool, plr)
                        end
                    end
                end
            end
        end
    end
end)
